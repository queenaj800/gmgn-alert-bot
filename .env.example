# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=isi_token_dari_botfather

# Chat ID tujuan notifikasi (bisa chat pribadi atau grup)
TELEGRAM_CHAT_ID=isi_chat_id_kamu

# API key gratis dari birdeye.so (untuk tahap "temukan" koin trending)
BIRDEYE_API_KEY=isi_api_key_birdeye

# PUMP_THRESHOLD: harga naik ke sini dulu baru siklus dianggap mulai
PRICE_HIGH=0.0001

# DUMP_THRESHOLD: harga turun ke sini setelah pernah pump = sinyal terkirim
PRICE_LOW=0.00005

# Di bawah likuiditas ini (USD), notifikasi diberi label "RISIKO LIKUIDITAS TINGGI"
LIQUIDITY_MIN_USD=10000

# Di bawah likuiditas ini (USD), harga dianggap TIDAK BISA DIPERCAYA sama sekali
# (rawan angka palsu dari pool nyaris kosong) — token dilewati, tidak diproses
MIN_LIQUIDITY_FOR_SIGNAL_USD=2000

# Di bawah market cap ini (USD), token diabaikan TOTAL — jaring pengaman dasar,
# bukan filter utama (filter dexId=pumpfun & umur di bawah sudah lebih presisi).
MIN_MARKET_CAP_USD=10000

# dexId pair yang ditolak total (pisahkan koma). Default: token yang masih di bonding
# curve pump.fun (belum lulus ke PumpSwap/AMM sungguhan).
EXCLUDE_DEX_IDS=pumpfun

# Umur token (menit sejak pair dibuat) yang diterima — sesuai pengalaman: V-shape
# rebound paling sering terjadi pada koin 20 menit - 1 jam. Sesuaikan sesuai temuanmu.
MIN_TOKEN_AGE_MINUTES=20
MAX_TOKEN_AGE_MINUTES=60

# Jumlah holder minimum (sumber: Birdeye token_overview). Set ke false untuk menonaktifkan
# kalau ternyata terlalu boros compute unit Birdeye.
MIN_HOLDER_COUNT=600
ENABLE_HOLDER_CHECK=true

# Volume 1 jam di bawah ini (USD) = dianggap tidak ada aktivitas trading nyata, diabaikan
MIN_VOLUME_1H_USD=1000

# Skor risiko RugCheck (0-100). Token dengan skor >= ini (mint/freeze authority aktif,
# holder sangat terpusat, dll) otomatis ditolak.
RUGCHECK_MAX_RISK_SCORE=50

# Kata kunci tambahan brand yang sering ditiru scam (pisahkan koma), digabung dengan
# daftar default (openai, robinhood, tesla, dll). Contoh: EXTRA_SCAM_KEYWORDS=starlink,grok
EXTRA_SCAM_KEYWORDS=

# Opsional: path folder untuk menyimpan state.json (riwayat harga).
# Arahkan ke mount path Railway Volume (mis. /data) supaya tidak hilang saat redeploy.
# Kosongkan untuk pakai folder default (tidak permanen di Railway).
STATE_DIR=

# Interval refresh daftar koin trending dari Birdeye (menit)
# /defi/tokenlist = 30 CU/panggilan, jatah gratis 30.000 CU/bulan (~1000 panggilan/bulan)
# 45 menit sekali sudah aman dengan margin; jangan turunkan banyak di bawah ini
DISCOVER_INTERVAL_MINUTES=45

# Interval cek harga & volume koin di watchlist lewat DexScreener.
# ISI SALAH SATU: CHECK_INTERVAL_SECONDS (lebih presisi, diutamakan kalau diisi)
# atau CHECK_INTERVAL_MINUTES (default 1 menit kalau keduanya kosong).
# Contoh: mau cek tiap 20 detik → isi CHECK_INTERVAL_SECONDS=20, kosongkan yang MINUTES.
# Jangan terlalu kecil — dengan ~80-110 koin di watchlist, 1 siklus butuh sekitar
# 8-11 detik untuk selesai (0.1 detik x jumlah koin). Disarankan minimal 15-20 detik.
CHECK_INTERVAL_SECONDS=
CHECK_INTERVAL_MINUTES=1

# Jumlah koin yang dicek BERSAMAAN (paralel) per batch. 5 sudah aman untuk DexScreener.
BATCH_SIZE=5

# Jumlah koin yang dipantau dari Birdeye (maks 50, batas endpoint /defi/tokenlist)
TOP_N=50

# Jumlah halaman GeckoTerminal yang diambil (tiap halaman = 20 pool, gratis sampai 10 halaman).
# 3 = 60 pool tambahan. Naikkan untuk cakupan lebih luas, tapi siklus cek harga jadi lebih lama.
GECKO_PAGES=3

# Jumlah koin yang dicek BERSAMAAN (paralel) tiap siklus. 8 sudah seimbang aman;
# naikkan kalau mau lebih cepat, turunkan kalau mulai sering error dari DexScreener.
CONCURRENT_CHECKS=8
