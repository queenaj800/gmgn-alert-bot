# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=isi_token_dari_botfather

# Chat ID tujuan notifikasi (bisa chat pribadi atau grup)
TELEGRAM_CHAT_ID=isi_chat_id_kamu

# API key gratis dari birdeye.so (untuk tahap "temukan" koin trending)
BIRDEYE_API_KEY=isi_api_key_birdeye

# Ambang batas sinyal (USD) — sesuaikan kalau perlu
PRICE_HIGH=0.0001
PRICE_LOW=0.00003

# Interval refresh daftar koin trending dari Birdeye (menit)
# Jangan terlalu kecil — tiap panggilan makan 40 compute unit,
# dan jatah gratis cuma 30.000 CU/bulan (~750 panggilan/bulan = 60 menit sekali)
DISCOVER_INTERVAL_MINUTES=60

# Interval cek harga & volume koin di watchlist lewat DexScreener (menit)
# DexScreener gratis tanpa batas CU, jadi ini bisa dibuat sering
CHECK_INTERVAL_MINUTES=1

# Jumlah koin trending yang dipantau (maks 20, batas endpoint Birdeye)
TOP_N=20
